  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary-lg",
      "description": "The one blue action of a view (Baixar, Usar a câmera); 48px when it is the main action.",
      "html": "<button class=\"ds-btn-primary\"><svg viewBox=\"0 0 1024 1024\" width=\"18\" height=\"18\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M505.7 661a8 8 0 0 0 12.6 0l112-141.7c4.1-5.2.4-12.9-6.3-12.9h-74.1V168c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8v338.3H400c-6.7 0-10.4 7.7-6.3 12.9l112 141.8zM878 626h-60c-4.4 0-8 3.6-8 8v154H214V634c0-4.4-3.6-8-8-8h-60c-4.4 0-8 3.6-8 8v198c0 17.7 14.3 32 32 32h684c17.7 0 32-14.3 32-32V634c0-4.4-3.6-8-8-8z\"/></svg>Baixar PNG</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:44px;padding:0.625rem 1rem;border-radius:var(--radius);border:1px solid transparent;font-family:var(--font-main);font-size:0.9375rem;font-weight:600;line-height:1.2;white-space:nowrap;cursor:pointer;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out),color 150ms var(--ease-out);min-height:48px;font-size:1rem;background:var(--primary);color:var(--on-primary);} .ds-btn-primary:hover{background:var(--primary-hover);} .ds-btn-primary:active{background:var(--primary-pressed);} .ds-btn-primary:focus-visible{outline:2px solid var(--primary);outline-offset:2px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral companion actions: Copiar, Escolher imagem, Enviar imagem.",
      "html": "<button class=\"ds-btn-secondary\">Copiar</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:44px;padding:0.625rem 1rem;border-radius:var(--radius);border:1px solid transparent;font-family:var(--font-main);font-size:0.9375rem;font-weight:600;line-height:1.2;white-space:nowrap;cursor:pointer;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out),color 150ms var(--ease-out);background:var(--bg-panel);border-color:var(--border-strong);color:var(--text-main);} .ds-btn-secondary:hover{background:var(--bg-sunken);} .ds-btn-secondary:focus-visible{outline:2px solid var(--primary);outline-offset:2px;}"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "The quietest action: share row and scan-result shortcuts. Never blue.",
      "html": "<div class=\"ds-link-row\"><button class=\"ds-btn-link\">Copiar texto</button><button class=\"ds-btn-link\">WhatsApp</button><button class=\"ds-btn-link\">Facebook</button></div>",
      "css": ".ds-link-row{display:flex;gap:0.25rem;} .ds-btn-link{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:44px;padding:0.625rem 1rem;border-radius:var(--radius);border:1px solid transparent;font-family:var(--font-main);font-size:0.9375rem;font-weight:600;line-height:1.2;white-space:nowrap;cursor:pointer;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out),color 150ms var(--ease-out);padding:0.375rem 0.5rem;background:transparent;color:var(--text-muted);font-weight:500;} .ds-btn-link:hover{background:var(--bg-sunken);color:var(--text-main);} .ds-btn-link:focus-visible{outline:2px solid var(--primary);outline-offset:2px;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label, 44px field with Field Stroke border, blue border plus 3px ring on focus, faint hint.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Conteúdo</span><textarea class=\"ds-input\" placeholder=\"Cole um link ou digite um texto, e-mail ou telefone\"></textarea><span class=\"ds-field-hint\">O QR Code muda enquanto você digita.</span></label>",
      "css": ".ds-field{display:block;font-family:var(--font-main);} .ds-field-label{display:block;font-size:0.875rem;font-weight:500;color:var(--text-muted);margin-bottom:0.375rem;} .ds-input{display:block;width:100%;box-sizing:border-box;min-height:5.5rem;padding:0.625rem 0.75rem;background:var(--bg-panel);border:1px solid var(--border-strong);border-radius:var(--radius);font:inherit;font-size:1rem;line-height:1.4;color:var(--text-main);resize:vertical;transition:border-color 150ms var(--ease-out),box-shadow 150ms var(--ease-out);} .ds-input::placeholder{color:var(--text-faint);opacity:1;} .ds-input:hover{border-color:var(--text-faint);} .ds-input:focus{outline:none;border-color:var(--primary);box-shadow:var(--focus-ring);} .ds-field-hint{display:block;font-size:0.8125rem;color:var(--text-faint);margin-top:0.375rem;}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-option-selected",
      "description": "Native radios in a sunken track; the selected option is a white pill. Replaces chips and toggles.",
      "html": "<fieldset class=\"ds-seg\"><legend class=\"ds-seg-legend\">Correção de erro</legend><div class=\"ds-seg-track\"><label class=\"ds-seg-opt\"><input type=\"radio\" name=\"ds-ec\">L<small>7%</small></label><label class=\"ds-seg-opt\"><input type=\"radio\" name=\"ds-ec\">M<small>15%</small></label><label class=\"ds-seg-opt\"><input type=\"radio\" name=\"ds-ec\">Q<small>25%</small></label><label class=\"ds-seg-opt is-on\"><input type=\"radio\" name=\"ds-ec\" checked>H<small>30%</small></label></div></fieldset>",
      "css": ".ds-seg{margin:0;padding:0;border:0;min-width:0;font-family:var(--font-main);} .ds-seg-legend{font-size:0.875rem;font-weight:500;color:var(--text-muted);margin-bottom:0.375rem;padding:0;} .ds-seg-track{display:flex;gap:4px;padding:4px;background:var(--bg-sunken);border-radius:var(--radius);} .ds-seg-opt{position:relative;flex:1 1 0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:40px;padding:0.375rem 0.5rem;border-radius:var(--radius-sm);color:var(--text-muted);font-size:0.875rem;font-weight:500;line-height:1.2;cursor:pointer;transition:background-color 150ms var(--ease-out),color 150ms var(--ease-out),box-shadow 150ms var(--ease-out);} .ds-seg-opt input{position:absolute;inset:0;margin:0;opacity:0;cursor:pointer;} .ds-seg-opt small{font-size:0.75rem;font-weight:400;color:var(--text-faint);font-variant-numeric:tabular-nums;} .ds-seg-opt:hover{color:var(--text-main);} .ds-seg-opt.is-on{background:var(--bg-panel);color:var(--text-main);font-weight:600;box-shadow:0 1px 3px rgba(17,24,39,0.12),0 0 0 1px var(--border);} .ds-seg-opt:has(input:focus-visible){outline:2px solid var(--primary);outline-offset:1px;}"
    },
    {
      "name": "Mode Switch",
      "kind": "nav",
      "refersTo": "mode-switch-selected",
      "description": "Primary navigation between the three modes; the large segmented control with a blue-washed selection.",
      "html": "<div class=\"ds-mode\" role=\"radiogroup\" aria-label=\"Modo\"><label class=\"ds-mode-opt is-on\"><input type=\"radio\" name=\"ds-mode\" checked>QR Code</label><label class=\"ds-mode-opt\"><input type=\"radio\" name=\"ds-mode\">Código de barras</label><label class=\"ds-mode-opt\"><input type=\"radio\" name=\"ds-mode\">Ler código</label></div>",
      "css": ".ds-mode{display:flex;gap:4px;max-width:600px;padding:5px;background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);font-family:var(--font-main);} .ds-mode-opt{position:relative;flex:1 1 0;display:flex;align-items:center;justify-content:center;gap:0.5rem;min-height:48px;padding:0.5rem 1rem;border-radius:var(--radius);color:var(--text-muted);font-size:0.9375rem;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color 150ms var(--ease-out),color 150ms var(--ease-out);} .ds-mode-opt input{position:absolute;inset:0;margin:0;opacity:0;cursor:pointer;} .ds-mode-opt:hover{color:var(--text-main);} .ds-mode-opt.is-on{background:var(--primary-soft);color:var(--primary-text);font-weight:600;} .ds-mode-opt:has(input:focus-visible){outline:2px solid var(--primary);outline-offset:1px;}"
    },
    {
      "name": "Panel with Sections",
      "kind": "card",
      "refersTo": "panel",
      "description": "White 12px panel with a hairline border; sections inside divide with a hairline rule, never a nested card.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-section\"><h3 class=\"ds-section-title\">Cores</h3><p class=\"ds-muted\">Cor do código e cor do fundo.</p></div><div class=\"ds-panel-section\"><h3 class=\"ds-section-title\">Estilo</h3><p class=\"ds-muted\">Módulos, cantos e correção de erro.</p></div></section>",
      "css": ".ds-panel{background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);font-family:var(--font-main);color:var(--text-main);} .ds-panel-section{padding:1.25rem 1.5rem;} .ds-panel-section + .ds-panel-section{border-top:1px solid var(--border);} .ds-section-title{margin:0 0 1rem;font-size:1rem;font-weight:600;line-height:1.4;} .ds-muted{margin:0;font-size:0.875rem;color:var(--text-muted);}"
    },
    {
      "name": "Preview Stage",
      "kind": "custom",
      "refersTo": "preview-stage",
      "description": "Signature: the code centred on a neutral sunken stage with a label-like lift, meta line beneath.",
      "html": "<div class=\"ds-stage-wrap\"><div class=\"ds-stage\"><svg class=\"ds-code\" viewBox=\"0 0 21 21\" width=\"168\" height=\"168\" aria-hidden=\"true\"><rect width=\"21\" height=\"21\" fill=\"#fff\"/><g fill=\"#000\"><path d=\"M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0z\"/></g><g fill=\"#fff\"><path d=\"M1 1h5v5H1zM15 1h5v5h-5zM1 15h5v5H1z\"/></g><g fill=\"#000\"><path d=\"M2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2zM9 1h1v2H9zM11 3h2v1h-2zM8 8h3v1H8zM12 9h2v2h-2zM9 11h1v3H9zM15 12h3v1h-3zM11 15h2v2h-2zM16 16h3v3h-3zM14 18h1v2h-1zM9 17h1v3H9zM18 9h2v1h-2z\"/></g></svg></div><p class=\"ds-stage-meta\">QR Code · 280 px</p></div>",
      "css": ".ds-stage-wrap{display:flex;flex-direction:column;gap:0.75rem;font-family:var(--font-main);} .ds-stage{display:grid;place-items:center;min-height:240px;padding:1.25rem;background:var(--bg-sunken);border-radius:var(--radius);} .ds-code{display:block;border-radius:2px;box-shadow:var(--shadow);} .ds-stage-meta{margin:0;text-align:center;font-size:0.875rem;color:var(--text-muted);font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge-ok",
      "description": "Pill on a state wash; valid NF-e key in green, failed check digit in amber.",
      "html": "<span class=\"ds-badge ds-badge-ok\">Chave válida</span> <span class=\"ds-badge ds-badge-warn\">Dígito não confere</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:0.375rem;padding:0.25rem 0.625rem;border-radius:999px;font-family:var(--font-main);font-size:0.8125rem;font-weight:600;} .ds-badge-ok{background:var(--success-soft);color:var(--success);} .ds-badge-warn{background:var(--warning-soft);color:var(--warning);}"
    },
    {
      "name": "Alert",
      "kind": "custom",
      "refersTo": "alert-danger",
      "description": "8px wash block with matching text for validation errors and warnings; no red borders on fields.",
      "html": "<div class=\"ds-alert ds-alert-danger\" role=\"alert\"><div><strong>EAN-13 precisa de 12 ou 13 dígitos.</strong><p>Exemplo: 789123456789</p></div></div>",
      "css": ".ds-alert{display:flex;gap:0.625rem;align-items:flex-start;padding:0.75rem 0.875rem;border-radius:var(--radius);font-family:var(--font-main);font-size:0.875rem;line-height:1.45;} .ds-alert strong{font-weight:600;} .ds-alert p{margin:0.25rem 0 0;} .ds-alert-danger{background:var(--danger-soft);color:var(--danger);} .ds-alert-warning{background:var(--warning-soft);color:var(--warning);}"
    }
